# Server
NODE_ENV=development
LOG_LEVEL=info # Options: debug, info, warn, error
SERVER_BASE_URL=http://localhost
PORT=5000 # Local API port; in Compose this is the published host port (container port stays 5000)
ADMIN_EMAIL=
ADMIN_PASSWORD=
COOKIE_SECRET=SuperSecretCookie
COOKIE_MAX_AGE=1209600

# Client
CLIENT_BASE_URL=http://localhost:5173

# Database
DB_REPO=MONGO # Options: MONGO, SQLITE; selects the database for local scripts and all Compose services
DB_SQLITE_FILE=data/db.sqlite
DB_MONGO_URL=mongodb+srv://cinkes:<db_password>@bookshop-prod.k6etncy.mongodb.net/bookshop?retryWrites=true&w=majority&authSource=admin&appName=bookshop
MONGO_BACKUP_MODE=logical # Atlas M0: pause all writers for consistency. Oplog mode derives a database-free URI on supported replica sets.
BACKUP_RETENTION_DAILY=7 # Latest backup per occupied UTC day
BACKUP_RETENTION_WEEKLY=4 # Latest backup per occupied UTC week (Monday start); 0 disables
BACKUP_RETENTION_MONTHLY=12 # Latest backup per occupied UTC calendar month; 0 disables
BACKUP_RETENTION_DRY_RUN=false # Upload and verify, then report pruning candidates without deleting

# Docker Compose
COMPOSE_PROJECT_NAME=bookshop # Prefixes compose resources to avoid cross-repo collisions

# Nodemailer
MAILER_SERVICE=gmail
MAILER_HOST=smtp.gmail.com
MAILER_PORT=465
MAILER_SECURE=true
MAILER_USER=
MAILER_PASS=

# JWT
ACCESS_TOKEN_SECRET=SuperSecretAccess
REFRESH_TOKEN_SECRET=SuperSecretRefresh
ACCESS_TOKEN_EXPIRATION=900
REFRESH_TOKEN_EXPIRATION=1209600

# ngrok
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Stripe
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PUBLISHED_PORT=6380

# Cronitor
CRONITOR_API_KEY=
