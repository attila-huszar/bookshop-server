# Server
NODE_ENV=development
LOG_LEVEL=info # Options: debug, info, warn, error
SERVER_BASE_URL=http://localhost
PORT=5000 # Local API port; in Compose this is the published host port (container port stays 5000)
ADMIN_EMAIL=
ADMIN_PASSWORD=
COOKIE_SECRET=SuperSecretCookie
COOKIE_MAX_AGE=1209600

# Client
CLIENT_BASE_URL=http://localhost:5173

# Google sign-in (optional; use the same Web application client ID in the frontend)
GOOGLE_CLIENT_ID=

# Database
DB_REPO=MONGO # Options: MONGO, SQLITE; selects the database for setup, scripts and Compose services
DB_SQLITE_FILE=data/db.sqlite
DB_MONGO_URL=mongodb+srv://<username>:<db_password>@<cluster-host>/bookshop-dev
MONGO_BACKUP_MODE=logical # Compose pauses its writers during the dump; external writers must also be stopped.
BACKUP_RETENTION=7,4,12 # Daily,weekly,monthly counts; weekly/monthly: 0 disables

# Docker Compose
COMPOSE_PROJECT_NAME=bookshop # Prefixes compose resources to avoid cross-repo collisions

# Nodemailer
MAILER_SERVICE=gmail
MAILER_HOST=smtp.gmail.com
MAILER_PORT=465
MAILER_SECURE=true
MAILER_USER=
MAILER_PASS=

# JWT
ACCESS_TOKEN_SECRET=SuperSecretAccess
REFRESH_TOKEN_SECRET=SuperSecretRefresh
ACCESS_TOKEN_EXPIRATION=900
REFRESH_TOKEN_EXPIRATION=1209600

# ngrok
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Stripe
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PUBLISHED_PORT=6380

# Cronitor
CRONITOR_API_KEY=
