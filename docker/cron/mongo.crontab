SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
TZ=UTC

# Every 10 minutes: reconcile orders and clean up expired account data
*/10 * * * * su -p -s /bin/sh bun -c 'exec /bin/sh /bookshop-server/docker/cron/jobs/maintenance.sh' >> /proc/1/fd/1 2>&1

# Daily at 02:30 UTC: upload and verify a MongoDB backup archive in S3
30 2 * * * su -p -s /bin/sh bun -c 'exec /bin/sh /bookshop-server/docker/cron/jobs/backup_mongo.sh' >> /proc/1/fd/1 2>&1
