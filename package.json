{
  "name": "bookshop-server",
  "module": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n client,docker \"bun run --cwd ../bookshop-client dev:client\" \"bun run docker:dev\" --teardown \"docker compose stop\"",
    "docker:dev": "cross-env NODE_ENV=development BUN_RUN_MODE=--watch NGROK_AUTHTOKEN= docker compose up --build --abort-on-container-exit",
    "docker:start": "docker compose up --build --wait",
    "setup": "bun src/scripts/setup.ts",
    "lint": "bun --bun eslint . --max-warnings 0",
    "typecheck": "bun --bun tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/lib-storage": "^3.1168.0",
    "@hono/bun": "^1.0.1",
    "@ngrok/ngrok": "^1.8.0",
    "bullmq": "^6.7.6",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "google-auth-library": "^11.3.4",
    "hono": "^4.13.18",
    "hono-rate-limiter": "^0.5.4",
    "http-status": "^2.1.0",
    "ioredis": "^6.0.0",
    "mjml": "^5.4.1",
    "mongoose": "^9.12.1",
    "nodemailer": "^10.5.0",
    "sharp": "^0.35.5",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "^1.4.4",
    "@types/mjml": "^5.4.2",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
