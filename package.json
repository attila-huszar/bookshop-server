{
  "name": "bookshop-server",
  "module": "app.ts",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,worker -c green,cyan \"bun run dev:server\" \"bun run dev:worker\"",
    "dev:server": "bun --hot src/app.ts",
    "dev:worker": "bun --watch src/workers/email.worker.ts",
    "docker:up": "docker compose up",
    "docker:setup": "bun -e \"const p = Bun.spawn(['docker', 'compose', 'up'], { env: { ...process.env, SETUP: 'true' }, stdin: 'inherit', stdout: 'inherit', stderr: 'inherit' }); await p.exited\"",
    "lint": "bun --bun eslint . --max-warnings 0",
    "typecheck": "bun --bun tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "bun src/database/migrate.ts",
    "seed": "bun src/database/seed.ts",
    "worker:email": "bun src/workers/email.worker.ts",
    "cron:cleanup": "bun src/scripts/cleanupTokens.ts",
    "backup:sqlite": "bun src/scripts/backupSqlite.ts",
    "backup:mongo": "bun src/scripts/backupMongo.ts"
  },
  "bun": {
    "test": {
      "preload": [
        "src/tests/test-setup.ts"
      ]
    }
  },
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "bullmq": "^6.3.4",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.7",
    "hono-rate-limiter": "^0.5.4",
    "http-status": "^2.1.0",
    "ioredis": "^6.0.0",
    "mjml": "^5.4.1",
    "mongoose": "^9.10.0",
    "nodemailer": "^10.0.9",
    "stripe": "^22.6.2",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "^1.4.2",
    "@types/mjml": "^5.0.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
